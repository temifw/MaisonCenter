# client/.env.example — copy to client/.env for local development.
#
# Vite only exposes variables prefixed with VITE_ to the browser, and it
# BAKES THEM IN AT BUILD TIME. Changing this on Vercel therefore needs a
# redeploy, not just a restart. Never put a secret in a VITE_ variable —
# anything here is readable in the shipped JavaScript bundle.

# Local development (the Express server from `npm run dev` at repo root):
VITE_API_URL=http://localhost:3000/api

# On Vercel, set this in Project Settings > Environment Variables to your
# deployed API project, e.g.
#   VITE_API_URL=https://maisoncenter-api.vercel.app/api

VITE_APP_NAME=Hotel Booking
