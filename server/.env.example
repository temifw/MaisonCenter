# =====================================================================
# server/.env.example — copy to server/.env and fill in.
# NEVER commit the real .env; it holds credentials.
# =====================================================================

PORT=3000

# ----- Supabase ------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
# Optional but needed for staff login / staff checks. Bypasses RLS —
# server only, never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of front-end origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# =====================================================================
# SMTP — booking confirmation emails
# =====================================================================
# These values are for Brevo (https://brevo.com). See EMAIL_SETUP.md.
#   Host: smtp-relay.brevo.com
#   Port: 587  (STARTTLS — leave SMTP_SECURE unset or false)
#         465  (implicit TLS — set SMTP_SECURE=true)
#         2525 (fallback if your host blocks 587)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

# Brevo's SMTP login is NOT your account email — copy it from
# Brevo > SMTP & API > SMTP. It looks like 9a1b2c001@smtp-brevo.com
SMTP_USER=
# The generated SMTP key (starts with xsmtpsib-...). NOT your password.
SMTP_PASS=

# Leave unset to auto-derive from the port (465 -> true, else false).
# SMTP_SECURE=false

# ----- Sender identity -----------------------------------------------
# FROM_EMAIL must be an address you verified with Brevo, otherwise the
# send is rejected. Use a domain you own once DNS is set up.
FROM_EMAIL=bookings@yourdomain.com
FROM_NAME=Maison Center
# Where guest replies land. Falls back to HOTEL_EMAIL, then FROM_EMAIL.
REPLY_TO=
# Optional: silently copy the front desk on every confirmation.
BCC_EMAIL=

# ----- Hotel details shown in the email ------------------------------
HOTEL_NAME=Maison Center
HOTEL_ADDRESS=
HOTEL_PHONE=
HOTEL_EMAIL=
# Public URL of the customer site — used to build the "Manage your
# booking" link (SITE_URL + /my-booking). No trailing slash.
SITE_URL=http://localhost:5173

# Currency symbol prefixed to prices in the email.
CURRENCY_SYMBOL=$

# Set to true to test SMTP credentials on server boot (logs pass/fail).
VERIFY_SMTP_ON_BOOT=false
