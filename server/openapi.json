{
  "openapi": "3.0.3",
  "info": {
    "title": "MaisonCenter API",
    "version": "1.0.0",
    "description": "API for hotel room availability, bookings, and admin management (Supabase + Node/Express)."
  },
  "servers": [
    { "url": "http://localhost:5000", "description": "Local dev" }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Availability" },
    { "name": "Customer" },
    { "name": "Admin" },
    { "name": "Admin Inventory" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase access token (session.access_token)"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "code": { "type": "string", "nullable": true },
              "details": {}
            },
            "required": ["message"]
          }
        },
        "required": ["error"]
      },
      "AvailabilityRoom": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "room_number": { "type": "string" },
          "room_type": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "name": { "type": "string" },
              "base_price_cents": { "type": "integer" },
              "max_guests": { "type": "integer" }
            },
            "required": ["id", "name", "base_price_cents", "max_guests"]
          },
          "pricing": {
            "type": "object",
            "properties": {
              "nights": { "type": "integer" },
              "base_price_cents": { "type": "integer" },
              "total_cents": { "type": "integer" }
            },
            "required": ["nights", "base_price_cents", "total_cents"]
          }
        },
        "required": ["id", "room_number", "room_type", "pricing"]
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "room_id": { "type": "string", "format": "uuid" },
          "price_total_cents": { "type": "integer" },
          "check_in": { "type": "string", "format": "date" },
          "check_out": { "type": "string", "format": "date" },
          "guests_count": { "type": "integer" },
          "status": {
            "type": "string",
            "enum": ["confirmed", "cancelled", "checked_in", "checked_out"]
          },
          "customer_email": { "type": "string" },
          "customer_name": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": [
          "id",
          "user_id",
          "room_id",
          "price_total_cents",
          "check_in",
          "check_out",
          "guests_count",
          "status",
          "customer_email",
          "created_at",
          "updated_at"
        ]
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "ok": { "type": "boolean" } },
                  "required": ["ok"]
                }
              }
            }
          }
        }
      }
    },
    "/api/availability/rooms": {
      "get": {
        "tags": ["Availability"],
        "summary": "List available rooms for a date range (unavailable rooms omitted)",
        "parameters": [
          { "name": "check_in", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "check_out", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "guests", "in": "query", "required": false, "schema": { "type": "integer", "default": 1, "minimum": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Available rooms",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "query": { "type": "object" },
                        "pricing": { "type": "object" },
                        "rooms": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/AvailabilityRoom" }
                        }
                      },
                      "required": ["rooms"]
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          },
          "400": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "500": { "description": "Server error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/customer/bookings": {
      "get": {
        "tags": ["Customer"],
        "summary": "List bookings for the logged-in customer",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Customer bookings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "bookings": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Booking" }
                        }
                      },
                      "required": ["bookings"]
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "tags": ["Customer"],
        "summary": "Create booking (confirmed immediately)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "room_id": { "type": "string", "format": "uuid" },
                  "check_in": { "type": "string", "format": "date" },
                  "check_out": { "type": "string", "format": "date" },
                  "guests_count": { "type": "integer", "minimum": 1 }
                },
                "required": ["room_id", "check_in", "check_out", "guests_count"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Booking" }
                  },
                  "required": ["data"]
                }
              }
            }
          },
          "409": { "description": "Conflict (room unavailable)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    }
  }
}