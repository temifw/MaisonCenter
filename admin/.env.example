# admin/.env.example — copy to admin/.env for local development.
#
# Vite only exposes VITE_-prefixed variables to the browser and bakes
# them in at build time, so a change on Vercel needs a redeploy. Never
# put a secret here — it ships in the JavaScript bundle.

# Local development (the Express server from `npm run dev` at repo root):
VITE_API_URL=http://localhost:3000/api

# On Vercel, set this in Project Settings > Environment Variables, e.g.
#   VITE_API_URL=https://maisoncenter-api.vercel.app/api

VITE_APP_NAME=Hotel Admin
